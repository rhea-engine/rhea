# gui for main app
#
[scene]
name="cetogui"

[Inter20]
type="//meworla/bitmapfont"
texture="//rhea/fonts/Inter20_0.png"
font_size=20
font_info="//rhea/fonts/Inter20.fnt"

[guisassets]
type="//meworla/resources"
browser="//ceto/openbrowser.scene"

[arrowup]
type="//meworla/texture"
path="//ceto/images/arrow-up.png"

[gui]
type="//meworla/gui"
texture="//ceto/images/20230101_154306.jpg"
stylesheet="//ceto/cetogui.css"
font_size=16

[gui/toptext]
type="//meworla/gui/label"
text="Welcome to Ceto"
x=10
y=10
w=330
h=80

[gui/widget1]
type="//meworla/gui/widget"
x=10
y=420

[gui/red]
type="//meworla/gui/widget"
texture="//ceto/images/darkred.png"
w=1
h=1
x=0
y=0

[gui/blue]
type="//meworla/gui/widget"
texture="//ceto/images/greyblue.png"
w=1
h=1
x=0
y=0

[gui/widget1/laber]
type="//meworla/gui/label"
text="Zis is a label"
x=10
y=10
w=360
h=80
templating=false

[gui/quit]
type="//meworla/gui/dialog"
w=420
h=100

[gui/quit/text]
type="//meworla/gui/label"
text="Do you really want to quit?"
x=10
y=10
w=360
h=80

[gui/quit/btn_row]
type="//meworla/gui/row"
y=60
h=40
fillwidth=true

[gui/quit/btn_row/ok]
type="//meworla/gui/button"
text="OK"
action="submit"
cssclass="btn"
default=true

[gui/quit/btn_row/cancel]
type="//meworla/gui/button"
text="Abbrechen"
action="cancel"
cssclass="btn"

[gui/alert]
type="//meworla/gui/dialog"
w=380
h=100

[gui/alert/info]
type="//meworla/gui/label"
text="info"
x=20
y=10
w=280
h=40

[gui/alert/ok]
type="//meworla/gui/button"
text="OK"
x=180
y=60
h=30
w=40
action="submit"
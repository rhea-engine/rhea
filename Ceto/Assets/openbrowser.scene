[scene]
name="realms"
type="//ceto/gui/openbrowser"
cssclass="open-browser"

[content]
type="//meworla/gui/column"
cssclass="open-browser-content"

[content/realms_title]
type="//meworla/gui/label"
text="Open World"
cssclass="dialog-title"

[content/layout]
type="//meworla/gui/row"
cssclass="open-layout"

[content/layout/realms]
type="//meworla/gui/column"
cssclass="realms-column"

[content/layout/realms/scroll]
type="//meworla/gui/scrollview"
cssclass="realms-scroll"

[content/layout/realms/scroll/list]
type="//meworla/gui/list"
item_padding=2

[content/layout/entries]
type="//meworla/gui/column"
cssclass="recent-column"

[content/layout/entries/location]
type="//meworla/gui/row"
cssclass="location-row"

[content/layout/entries/location/up]
type="//meworla/gui/button"
cssclass="location-button"
action="navigate_up"

[content/layout/entries/location/location_input]
type="//meworla/gui/textinput"
placeholder="Search"
fillwidth=true
onSubmit="open"

[content/layout/entries/scroll]
type="//meworla/gui/scrollview"
cssclass="recent-scroll"

[content/layout/entries/scroll/list]
type="//meworla/gui/list"
item_padding=2

[content/statusrow]
type="//meworla/gui/row"

[content/statusrow/status_label]
type="//meworla/gui/label"
cssclass="status-label"

[content/statusrow/open]
type="//meworla/gui/button"
text="Open"
onClicked="open"
cssclass="btn"
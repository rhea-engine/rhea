[scene]
name="viewerpanel"
type="//ceto/gui/viewerpanel"
cssclass="viewer-panel"

[content]
type="//meworla/gui/row"
cssclass="viewer-panel-content"

[content/animations]
type="//meworla/gui/column"
cssclass="viewer-panel-section"

[content/animations/label]
type="//meworla/gui/label"
text="Animations"
cssclass="viewer-panel-title"

[content/animations/playlist]
type="//meworla/gui/scrollview"
cssclass="viewer-panel-scroll"

[content/animations/playlist/entries]
type="//meworla/gui/column"
fillwidth=true
cssclass="viewer-panel-entries"

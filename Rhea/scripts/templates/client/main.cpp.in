#include <{{INCLUDE_PREFIX}}/{{PROJECT_NAME}}.h>
#include <Rhea/Physics/PhysicsManagerService.h>
#include <Rhea/Physics/PhysicsService.h>
#include <Psio/Log.h>
#include <Rhea/Controller/ControllerService.h>
#include <Rhea/Core/WorldService.h>

// Implementation

{{PROJECT_NAME}}::{{PROJECT_NAME}}() :
	m_world_scene(nullptr),
	Application()
{
}

{{PROJECT_NAME}}::~{{PROJECT_NAME}}()
{
}

void {{PROJECT_NAME}}::setup()
{
	addDefaultWindow();
	m_windows[0].views[0].layers.push_back({ "HUD",0,0,m_windows[0].width, m_windows[0].height });

	Application::setup();

	// register contoller service
	if (!getService("controller")) {
		log("Dragonstemple: Registering controller service");
		rhea::ControllerService* srv = new rhea::ControllerService("controllerservice");
		srv->setup(this);
		registerService("controller", srv);
	}
}

int main(int argc, char* argv[])
{
	{{PROJECT_NAME}}* app = new {{PROJECT_NAME}}();
	app->setAppname("{{PROJECT_NAME}}");

	app->init(argc, argv);

	int argi = 1;
	bool scene_set = false;
	std::string home_scene = "//{{PROJECT_NAME_LOWER}}/world.scene";

	while (argi < argc) {
		if (!strcmp(argv[argi], "-d")) {
			argi++;
			app->setAppDir(argv[argi]);
			LOG(LOG_INFO) << "Set //local to directory: " << argv[argi];
		}
		else if (argv[argi][0] != '-') {
			home_scene = argv[argi];
			scene_set = true;
		}
		argi++;
	}

	app->setup();

	auto* worlds = app->getService<rhea::WorldService>();

	worlds->openWorld(home_scene, [app, worlds](rhea::WorldService::OpenError error)
		{
			if (error != rhea::WorldService::OpenError::None) {
				LOG(LOG_ERROR) << "Failed to open world: " << static_cast<int>(error);
				return;
			}
		});

	app->loop();

	app->close();

	delete app;

	return 0;
}
cmake_minimum_required(VERSION 3.10)

project({{TARGET_NAME}})

set(RHEA_ENABLED_PROFILE_JSON "${CMAKE_SOURCE_DIR}/enabled.json")

include("${CMAKE_SOURCE_DIR}/mwpkg_installed/rhea/core/cmake/rhea_project.cmake")
include("${CMAKE_SOURCE_DIR}/mwpkg.cmake")
rhea_project_end()

add_executable({{TARGET_NAME}} src/{{PROJECT_NAME}}.cpp)

rhea_copy_assets({{TARGET_NAME}} "${CMAKE_CURRENT_SOURCE_DIR}/Assets" "{{PROJECT_NAME_LOWER}}")
rhea_copy_assets({{TARGET_NAME}} "${RHEA_ASSETS_DIR}" "rhea")

target_include_directories({{TARGET_NAME}} PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}/include")
target_link_libraries({{TARGET_NAME}} PRIVATE Rhea::Core Rhea::Client Meworla::Poseidon RheaFabrics)
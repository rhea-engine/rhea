#include <{{INCLUDE_PREFIX}}/{{PROJECT_NAME}}.h>
#include <Rhea/Physics/PhysicsManagerService.h>
#include <Rhea/Physics/PhysicsService.h>
#include <Psio/Log.h>

// Implementation

{{PROJECT_NAME}}::{{PROJECT_NAME}}() :
	m_world_scene(nullptr),
	Application()
{
}

{{PROJECT_NAME}}::~{{PROJECT_NAME}}()
{
}

void {{PROJECT_NAME}}::showScene(rhea::Scene* scene)
{
	auto* mgr = static_cast<rhea::PhysicsManagerService*>(getService("physics_mgr"));
	if (!mgr) {
		LOG(LOG_ERROR) << "physics_mgr missing";
		return;
	}

	auto* physics = mgr->createPhysicsService("world");
	if (!physics) {
		LOG(LOG_ERROR) << "physics backend missing";
		return;
	}
	physics->onInit();
	m_physics = physics;

	setScene(scene);

	scene->show();
}

int main(int argc, char* argv[])
{
	{{PROJECT_NAME}}* app = new {{PROJECT_NAME}}();
	app->setAppname("{{PROJECT_NAME}}");

	app->init();

	int argi = 1;
	bool scene_set = false;
	std::string home_scene;

	while (argi < argc) {
		if (!strcmp(argv[argi], "-d")) {
			argi++;
			app->setAppDir(argv[argi]);
			LOG(LOG_INFO) << "Set //local to directory: " << argv[argi];
		}
		else {
			home_scene = argv[argi];
			scene_set = true;
		}
		argi++;
	}

	app->setup();

	app->loadResource("//{{PROJECT_NAME_LOWER}}/world.scene", "meworla/scene", [&, app](rhea::Unit* scene, ReqError error) {
		rhea::Scene* world_scene = doCast<rhea::Scene>(scene);
		if (world_scene) {
			app->showScene(world_scene);
		}
		else {
			LOG(LOG_ERROR) << "Failed to load world scene";
		}
		return 0;
		});

	app->loop();

	app->close();

	delete app;

	return 0;
}
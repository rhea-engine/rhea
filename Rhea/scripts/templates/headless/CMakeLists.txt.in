cmake_minimum_required(VERSION 3.10)

project({{PROJECT_NAME}})

set(RHEA_ENABLED_PROFILE_JSON "${CMAKE_SOURCE_DIR}/enabled.json")

include("${CMAKE_SOURCE_DIR}/MwpkgModules/Meworla/Rhea/cmake/rhea_project.cmake")
include("${CMAKE_SOURCE_DIR}/mwpkg.cmake")
rhea_project_end()

add_executable({{PROJECT_NAME}} src/{{PROJECT_NAME}}.cpp)

target_include_directories({{PROJECT_NAME}} PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}/include")
target_link_libraries({{PROJECT_NAME}} PRIVATE Rhea::Core RheaFabrics)